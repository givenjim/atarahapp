{
  "name": "@atarah/api-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAPI contract generated from the backend, plus the generated TypeScript types and a typed fetch client.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "export": "pnpm --filter @atarah/backend openapi:export",
    "types": "openapi-typescript openapi.json -o src/schema.d.ts",
    "generate": "pnpm run export && pnpm run types"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0"
  }
}
