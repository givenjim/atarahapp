# Atarah backend â€” copy to .env (git-ignored). Never commit real values.
ATARAH_ENV=dev
ATARAH_PORT=3000
ATARAH_PUBLIC_URL=http://localhost:3000
ATARAH_CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# PostgreSQL 16 (infrastructure/docker-compose.yml)
ATARAH_DATABASE_URL=postgresql://atarah:atarah_dev_password@localhost:55432/atarah?schema=public

# Redis 7
ATARAH_REDIS_URL=redis://localhost:56379

# Auth â€” generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ATARAH_JWT_ACCESS_SECRET=change-me-dev-only-access-secret-min-32-chars
ATARAH_REFRESH_TOKEN_PEPPER=change-me-dev-only-refresh-pepper-min-32-chars
ATARAH_CODE_PEPPER=change-me-dev-only-code-pepper-min-32-chars
ATARAH_DATA_ENCRYPTION_KEY=change-me-dev-only-data-encryption-key-32+

# Object storage (S3-compatible server locally, see DEC-009)
ATARAH_S3_ENDPOINT=http://localhost:59000
ATARAH_S3_REGION=us-east-1
ATARAH_S3_ACCESS_KEY=atarah_s3
ATARAH_S3_SECRET_KEY=atarah_s3_dev_password
ATARAH_S3_BUCKET_PUBLIC=public-media
ATARAH_S3_BUCKET_PRIVATE=private-media
ATARAH_S3_BUCKET_EVIDENCE=verification-evidence

# Email (Mailpit locally)
ATARAH_SMTP_HOST=localhost
ATARAH_SMTP_PORT=51025
ATARAH_EMAIL_FROM="Atarah <no-reply@atarah.app>"

# SMS: "log" prints to the console in dev. Production provider is an owner decision.
# Origin for links in emails (universal-link domain; assumed until confirmed).
ATARAH_APP_LINK_BASE_URL=https://atarah.app
ATARAH_SMS_PROVIDER=log

# Push (Firebase Cloud Messaging). Leave empty in dev to disable the sender.
ATARAH_FCM_SERVICE_ACCOUNT_JSON=

# Error reporting. Leave empty to disable.
ATARAH_SENTRY_DSN=
