# Atarah backend. Copy to .env (git-ignored) or run `node scripts/supabase-env.mjs` to fill the Supabase values
# from the local stack. Never commit real values.
ATARAH_ENV=dev
ATARAH_PORT=3000
ATARAH_PUBLIC_URL=http://localhost:3000
ATARAH_CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Supabase (local stack: `just infra-up`; ports are offset to 553xx so it can run beside other projects).
# Runtime connects through the transaction pooler as the `atarah_backend` role; migrations use the direct URL.
ATARAH_DATABASE_URL=postgresql://atarah_backend.pooler-dev:CHANGE_ME@127.0.0.1:55329/postgres?pgbouncer=true&connection_limit=10
ATARAH_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Password for the atarah_backend role. Set by `node apps/backend/scripts/provision-backend-role.mjs`.
ATARAH_BACKEND_DB_PASSWORD=change-me-dev-only-backend-role
ATARAH_SUPABASE_URL=http://127.0.0.1:55321
# Only when clients reach Supabase on another address than the backend does. Leave empty locally (use `adb reverse`).
ATARAH_SUPABASE_PUBLIC_URL=
# Publishable (anon) key: needed for password change, email and phone change (public by design).
ATARAH_SUPABASE_PUBLISHABLE_KEY=
# SERVICE-ROLE / SECRET key: backend secret store only. Printed by `npx supabase status`.
ATARAH_SUPABASE_SECRET_KEY=
# Legacy HS256 JWT secret; leave empty on projects with asymmetric signing keys (JWKS is used).
ATARAH_SUPABASE_JWT_SECRET=
# Standard Webhooks secret for the Send SMS auth hook: same value as SEND_SMS_HOOK_SECRET in supabase/.env.
ATARAH_SEND_SMS_HOOK_SECRET=

ATARAH_REDIS_URL=redis://localhost:56379

# Storage buckets (created by the Supabase migration / local config)
ATARAH_STORAGE_BUCKET_PUBLIC=public-media
ATARAH_STORAGE_BUCKET_PRIVATE=private-media
ATARAH_STORAGE_BUCKET_EVIDENCE=verification-evidence

# Application email goes to Supabase's local mail catcher (web UI http://127.0.0.1:55324).
ATARAH_SMTP_HOST=localhost
ATARAH_SMTP_PORT=55325
ATARAH_EMAIL_FROM="Atarah <no-reply@atarah.app>"

# SMS: "log" prints to the console in dev. The production provider is an owner decision (section 12 #19).
ATARAH_SMS_PROVIDER=log
# Origin for links in emails (universal-link domain; assumed until confirmed).
ATARAH_APP_LINK_BASE_URL=https://atarah.app

# Push (Firebase Cloud Messaging). Leave empty in dev to disable the sender.
ATARAH_FCM_SERVICE_ACCOUNT_JSON=

# Error reporting. Leave empty to disable.
# Bearer token for GET /metrics. Required in staging and production; optional locally.
ATARAH_METRICS_TOKEN=

ATARAH_SENTRY_DSN=
