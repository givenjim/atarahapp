// Community (P1-M8): posts, comments, reactions, groups, blocks, mutes. Owner module: community.
// Moderation (reports, cases, the append-only action log) is owned by the same module. `connections` stays in
// creative.prisma (P1-M3). Every table is deny-all for the Supabase client roles (RLS on, no policies, no grants).

enum PostStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum GroupVisibility {
  /// Listed for every member; anyone can read and join.
  OPEN
  /// Not listed and not readable until the member is added by an administrator.
  PRIVATE
}

enum GroupRole {
  MEMBER
  MODERATOR
  OWNER
}

enum MuteTargetType {
  USER
  POST
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  GROUP
}

enum ModerationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// A post. `groupId` is set exactly when `audience` is GROUP (CHECK in the migration). Soft-deleted with `deletedAt`.
/// Counters change in the same transaction as the reaction or comment and are reconciled nightly.
model Post {
  id                  String                   @id @default(uuid()) @db.Uuid
  authorId            String                   @db.Uuid
  type                PostType
  body                String
  audience            PostAudience             @default(MEMBERS)
  groupId             String?                  @db.Uuid
  status              PostStatus               @default(VISIBLE)
  reactionCount       Int                      @default(0)
  replyCount          Int                      @default(0)
  isStaffAnnouncement Boolean                  @default(false)
  /// Generated full-text vector over the body. Read-only: the database maintains it.
  searchVector        Unsupported("tsvector")?
  editedAt            DateTime?
  isDemo              Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?

  author      User             @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  group       Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  media       PostMedia[]
  link        PostLink?
  attachments PostAttachment[]
  comments    Comment[]
  reactions   Reaction[]
  pins        GroupPin[]

  @@index([groupId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([searchVector], type: Gin, map: "posts_search_vector_idx")
  @@map("posts")
}

/// At most ten per post: `sortOrder` is 0-9 and unique per post (CHECK + unique index).
model PostMedia {
  id           String   @id @default(uuid()) @db.Uuid
  postId       String   @db.Uuid
  mediaAssetId String   @db.Uuid
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation("PostMediaAsset", fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaAssetId])
  @@unique([postId, sortOrder])
  @@map("post_media")
}

/// One link per post. The preview (`title`, `description`, `image`) is filled by the link-preview job through an
/// SSRF-safe fetcher; until `fetchedAt` is set the post shows the bare link.
model PostLink {
  id          String    @id @default(uuid()) @db.Uuid
  postId      String    @unique @db.Uuid
  url         String
  title       String?
  description String?
  image       String?
  siteName    String?
  fetchedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_links")
}

/// An attached opportunity (P1-M9 adds the foreign key; the attachment goes away with the opportunity).
model PostAttachment {
  id            String   @id @default(uuid()) @db.Uuid
  postId        String   @db.Uuid
  opportunityId String?  @db.Uuid
  createdAt     DateTime @default(now())

  post        Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([opportunityId])
  @@map("post_attachments")
}

/// Threaded one level: a reply's parent is always a top-level comment (trigger in the migration).
model Comment {
  id              String     @id @default(uuid()) @db.Uuid
  postId          String     @db.Uuid
  authorId        String     @db.Uuid
  parentCommentId String?    @db.Uuid
  body            String
  status          PostStatus @default(VISIBLE)
  editedAt        DateTime?
  isDemo          Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([authorId])
  @@map("comments")
}

model Reaction {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("ReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("reactions")
}

model Group {
  id           String          @id @default(uuid()) @db.Uuid
  slug         String          @unique
  type         GroupType
  name         String
  description  String          @default("")
  coverMediaId String?         @db.Uuid
  disciplineId String?         @db.Uuid
  countyId     String?         @db.Uuid
  /// Run by Atarah; created by administrators.
  isOfficial   Boolean         @default(false)
  visibility   GroupVisibility @default(OPEN)
  memberCount  Int             @default(0)
  createdById  String?         @db.Uuid
  archivedAt   DateTime?
  isDemo       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  coverMedia  MediaAsset?       @relation("GroupCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  discipline  Discipline?       @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  county      County?           @relation(fields: [countyId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships GroupMembership[]
  posts       Post[]
  pins        GroupPin[]

  @@index([type, archivedAt])
  @@index([disciplineId])
  @@index([countyId])
  @@map("groups")
}

model GroupMembership {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @db.Uuid
  userId    String    @db.Uuid
  role      GroupRole @default(MEMBER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_memberships")
}

model GroupPin {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @db.Uuid
  postId     String   @db.Uuid
  pinnedById String?  @db.Uuid
  createdAt  DateTime @default(now())

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  pinnedBy User? @relation("GroupPinner", fields: [pinnedById], references: [id], onDelete: SetNull)

  @@unique([groupId, postId])
  @@map("group_pins")
}

/// Blocking hides content both ways and stops requests, comments and mentions. One row per direction.
model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

/// A member hiding a user's posts, or one thread, from their own feed. `targetId` is a user or a post id.
model Mute {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  targetType MuteTargetType
  targetId   String         @db.Uuid
  createdAt  DateTime       @default(now())

  user User @relation("MutesMade", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("mutes")
}

/// A member's report. One per reporter and target. `targetId` has no foreign key (it points at the table named by
/// `targetType`). Every report belongs to the target's moderation case.
model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @db.Uuid
  targetType ReportTargetType
  targetId   String           @db.Uuid
  reason     ReportReason
  note       String?
  status     ReportStatus     @default(SUBMITTED)
  caseId     String?          @db.Uuid
  /// When the reporter was told the outcome (only the fact of a decision, never internal details).
  notifiedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  reporter User            @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  case     ModerationCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([caseId])
  @@map("reports")
}

/// One per reported target. A new report on a closed case reopens it.
model ModerationCase {
  id             String             @id @default(uuid()) @db.Uuid
  targetType     ReportTargetType
  targetId       String             @db.Uuid
  /// Whose content or account is reported (null for a group).
  targetAuthorId String?            @db.Uuid
  status         ReportStatus       @default(SUBMITTED)
  priority       ModerationPriority @default(NORMAL)
  assigneeId     String?            @db.Uuid
  reportCount    Int                @default(1)
  /// The reason on the first report.
  topReason      ReportReason
  resolvedAt     DateTime?
  /// Last time the backlog alert job raised this case (so it is raised once a day, not every run).
  alertedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  assignee User?                 @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reports  Report[]
  actions  ModerationActionLog[]

  @@unique([targetType, targetId])
  @@index([status, createdAt])
  @@index([assigneeId])
  @@map("moderation_cases")
}

/// Append-only (a trigger refuses UPDATE, DELETE and TRUNCATE, like `audit_logs`). `actorId` has no foreign key so
/// that deleting an account never has to touch this table.
model ModerationActionLog {
  id         String           @id @default(uuid()) @db.Uuid
  caseId     String           @db.Uuid
  action     ModerationAction
  reason     String?
  actorId    String           @db.Uuid
  targetType ReportTargetType
  targetId   String           @db.Uuid
  createdAt  DateTime         @default(now())

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("moderation_actions")
}

/// A member barred from posting, commenting and sending connection requests (RESTRICT_ACCOUNT).
/// Lifted by a RESTORE_CONTENT decision on the account or when it expires.
model CommunityRestriction {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  reason         String?
  restrictedById String    @db.Uuid
  expiresAt      DateTime?
  liftedAt       DateTime?
  createdAt      DateTime  @default(now())

  user User @relation("CommunityRestrictions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, liftedAt])
  @@map("community_restrictions")
}
