// Media and notifications. Owner modules: media, notifications.

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum StorageBucket {
  PUBLIC
  PRIVATE
  /// Government ID and verification evidence. Encrypted, reviewer-only, short-lived URLs.
  EVIDENCE
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  REJECTED
  DELETED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

model MediaAsset {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String?       @db.Uuid
  kind            MediaKind
  bucket          StorageBucket
  objectKey       String
  mimeType        String
  sizeBytes       BigInt
  status          MediaStatus   @default(PENDING_UPLOAD)
  width           Int?
  height          Int?
  durationSeconds Int?
  /// Generated renditions, e.g. { "200": "key", "600": "key", "1200": "key" }
  variants        Json?
  checksum        String?
  rejectionReason String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner          User?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  avatarOf       CreativeProfile[]
  projectMedia   ProjectMedia[]
  articleHeroes  Article[]             @relation("ArticleHero")
  postMedia      PostMedia[]           @relation("PostMediaAsset")
  groupCovers    Group[]               @relation("GroupCover")
  providerLogos  OpportunityProvider[] @relation("ProviderLogo")
  learningCovers LearningContent[]     @relation("LearningCover")
  lessonVideos   Lesson[]              @relation("LessonVideo")
  dataExports    DataExportRequest[]   @relation("DataExportFile")

  @@unique([bucket, objectKey])
  @@index([ownerId, status])
  @@map("media_assets")
}

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  category  NotificationCategory
  title     String
  body      String
  /// What happened, a dotted key such as `opportunity.reminder` (the app picks the icon and group from it).
  type      String?
  /// In-app route the notification opens, e.g. /opportunities/{id}.
  deepLink  String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, category, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("notifications")
}

/// Per category and channel. Defaults are created lazily; absence means the category default (on).
model NotificationPreference {
  id           String               @id @default(uuid()) @db.Uuid
  userId       String               @db.Uuid
  category     NotificationCategory
  pushEnabled  Boolean              @default(true)
  emailEnabled Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  appVersion String?
  lastSeenAt DateTime       @default(now())
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("device_tokens")
}

/// One row per notification delivery attempt key. The unique `dedupeKey` makes reminders and fan-out idempotent:
/// the dispatcher inserts first and skips the send when the key already exists.
model NotificationDispatch {
  id        String   @id @default(uuid()) @db.Uuid
  dedupeKey String   @unique
  userId    String?  @db.Uuid
  channel   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("notification_dispatches")
}
