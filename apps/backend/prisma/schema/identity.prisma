// Identity: accounts, devices, consent. Owner module: identity. Credentials, sessions, one-time codes and MFA
// live in Supabase Auth (the managed `auth` schema); `users.id` equals `auth.users.id` (FK created in SQL).
// Account status, roles, membership, verification and ownership are separate concepts (never one user.role).

enum LegalDocumentType {
  TERMS
  PRIVACY
  COMMUNITY_GUIDELINES
  PAYMENTS_REFUNDS
  SELLER_TERMS
  MENTOR_TERMS
}

/// Every account holds at least one of email or phone (CHECK constraint in the init_foundation migration).
model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String?       @unique @db.Citext
  /// E.164, e.g. +254712345678
  phone           String?       @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  fullName        String
  status          AccountStatus @default(PENDING_VERIFICATION)
  statusReason    String?
  statusChangedAt DateTime?
  /// A temporary suspension ends here (an hourly job reactivates the account). Null means until staff lift it.
  suspendedUntil  DateTime?
  lastLoginAt     DateTime?
  /// Demo seed records are flagged and never shown in production.
  isDemo          Boolean       @default(false)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  consents              ConsentRecord[]
  roles                 UserRole[]                 @relation("UserRoles")
  rolesGranted          UserRole[]                 @relation("UserRolesGrantedBy")
  memberships           Membership[]
  mediaAssets           MediaAsset[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference[]
  deviceTokens          DeviceToken[]
  devices               UserDevice[]
  preferences           MemberPreference?
  creativeProfile       CreativeProfile?
  connectionsSent       Connection[]               @relation("ConnectionRequester")
  connectionsReceived   Connection[]               @relation("ConnectionAddressee")
  suggestionsMade       SpecialisationSuggestion[] @relation("SuggestionAuthor")
  suggestionsResolved   SpecialisationSuggestion[] @relation("SuggestionResolver")
  projectCollaborations ProjectCollaborator[]      @relation("ProjectCollaborations")
  articlesCreated       Article[]                  @relation("ArticleCreator")
  articlesEdited        Article[]                  @relation("ArticleEditor")
  savedItems            SavedItem[]                @relation("SavedBy")
  recentSearches        RecentSearch[]             @relation("RecentSearcher")
  homeConfigEdits       HomeConfig[]               @relation("HomeConfigEditor")
  posts                 Post[]                     @relation("PostAuthor")
  comments              Comment[]                  @relation("CommentAuthor")
  reactions             Reaction[]                 @relation("ReactionAuthor")
  groupsCreated         Group[]                    @relation("GroupCreator")
  groupMemberships      GroupMembership[]          @relation("GroupMember")
  groupPins             GroupPin[]                 @relation("GroupPinner")
  blocksMade            Block[]                    @relation("BlocksMade")
  blocksReceived        Block[]                    @relation("BlocksReceived")
  mutesMade             Mute[]                     @relation("MutesMade")
  reportsMade           Report[]                   @relation("ReportsMade")
  casesAssigned         ModerationCase[]           @relation("CaseAssignee")
  communityRestrictions CommunityRestriction[]     @relation("CommunityRestrictions")
  opportunityTrackings  OpportunityTracking[]      @relation("OpportunityTracker")
  opportunitiesCreated  Opportunity[]              @relation("OpportunityCreator")
  providersOwned        OpportunityProvider[]      @relation("ProviderOwner")
  learningTaught        LearningContent[]          @relation("LearningInstructor")
  learningCreated       LearningContent[]          @relation("LearningCreator")
  enrolments            Enrolment[]                @relation("LearnerEnrolments")
  lessonProgress        LessonProgress[]           @relation("LearnerLessonProgress")
  contentProgress       ContentProgress[]          @relation("LearnerContentProgress")
  learningActivity      LearningActivityDaily[]    @relation("LearnerActivity")
  certificates          Certificate[]              @relation("LearnerCertificates")
  fieldVisibilities     ProfileFieldVisibility[]   @relation("FieldVisibilityOwner")
  twoStep               TwoStepSetting?            @relation("TwoStepOwner")
  contactChanges        ContactChangeRequest[]     @relation("ContactChangeOwner")
  dataExports           DataExportRequest[]        @relation("DataExportOwner")
  broadcastsCreated     NotificationBroadcast[]    @relation("BroadcastCreator")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// Member-level settings, one row per user. The source of truth for locale and time zone (moved off `users`).
/// The row is created lazily on first read or patch; a user without a row has the defaults.
model MemberPreference {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @unique @db.Uuid
  appearance     Appearance @default(LIGHT)
  locale         String     @default("en")
  timeZone       String     @default("Africa/Nairobi")
  marketingOptIn Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_preferences")
}

/// Consent captured with version and timestamp (Kenya Data Protection Act, 2019).
model ConsentRecord {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  documentType LegalDocumentType
  version      String
  acceptedAt   DateTime          @default(now())
  ip           String?
  source       String            @default("signup")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType])
  @@map("consent_records")
}

/// Legal text is supplied by the product owner. Until then every row is a DRAFT placeholder.
model LegalDocument {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType
  version     String
  title       String
  body        String
  status      PublicationStatus @default(DRAFT)
  effectiveAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([type, version])
  @@index([type, status])
  @@map("legal_documents")
}

/// A phone, browser or tablet the member has signed in on. Used for "new device" detection (two-step sign-in)
/// and the Active sessions list. `deviceHash` is a client-generated random id, never a hardware identifier.
model UserDevice {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  deviceHash    String
  name          String
  platform      DevicePlatform
  /// Supabase Auth session (`auth.sessions.id`) this device last registered with; joins the Active sessions list.
  lastSessionId String?        @db.Uuid
  lastSeenAt    DateTime       @default(now())
  /// Set once the device has passed two-step sign-in (or was registered on a two-step-verified session).
  verifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([userId, lastSeenAt(sort: Desc)])
  @@index([lastSessionId])
  @@map("user_devices")
}
