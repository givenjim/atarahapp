// Canonical vocabulary (Master Prompt §6). Values are exact and shared by every module.
// Where the prompt's enum name collides with an entity of the same name, the enum carries a `Key`
// suffix (RoleKey, MembershipPlanKey, EntitlementKey). Values are unchanged. See DEC-014.

// ---- 6.1 Accounts, roles, membership -------------------------------------------------------

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
  DELETED
}

/// Assignable, additive roles. Every active account is implicitly a member; Premium and Verified are never roles.
