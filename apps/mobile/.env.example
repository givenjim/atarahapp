# Atarah mobile — flavour config is passed with --dart-define-from-file, never committed with real values.
# Copy to env.dev.json / env.staging.json / env.prod.json (git-ignored) in this shape:
#
# {
#   "ATARAH_FLAVOR": "dev",
#   "ATARAH_API_BASE_URL": "http://10.0.2.2:3000",
#   "ATARAH_SUPABASE_URL": "http://127.0.0.1:55321",
#   "ATARAH_SUPABASE_PUBLISHABLE_KEY": "<PUBLISHABLE_KEY from `npx supabase status -o json`>",
#   "ATARAH_SENTRY_DSN": ""
# }
#
# 10.0.2.2 is the Android emulator's alias for the host machine's localhost. The Supabase URL stays on
# 127.0.0.1 and is reached through `adb reverse tcp:55321 tcp:55321` (the signed storage URLs the API returns
# use that host too). Auth needs both Supabase values; staging and prod have no default URL. The publishable
# key is a public client key, but it is still supplied per environment and never written into source.
ATARAH_FLAVOR=dev
ATARAH_API_BASE_URL=http://10.0.2.2:3000
ATARAH_SUPABASE_URL=http://127.0.0.1:55321
ATARAH_SUPABASE_PUBLISHABLE_KEY=
ATARAH_SENTRY_DSN=
