# Atarah mobile — flavour config is passed with --dart-define-from-file, never committed with real values.
# Copy to env.dev.json / env.staging.json / env.prod.json (git-ignored) in this shape:
#
# {
#   "ATARAH_FLAVOR": "dev",
#   "ATARAH_API_BASE_URL": "http://10.0.2.2:3000/api/v1",
#   "ATARAH_SENTRY_DSN": ""
# }
#
# 10.0.2.2 is the Android emulator's alias for the host machine's localhost.
ATARAH_FLAVOR=dev
ATARAH_API_BASE_URL=http://10.0.2.2:3000/api/v1
ATARAH_SENTRY_DSN=
