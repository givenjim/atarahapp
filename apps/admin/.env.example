# Atarah admin — copy to .env.local (git-ignored). Only NEXT_PUBLIC_* values reach the browser.
# Server-side API origin (no /api/v1). The Supabase session lives in httpOnly cookies set by this server.
ATARAH_API_BASE_URL=http://localhost:3000
# Supabase Auth (local stack: API on 55321). Only these two reach the browser bundle, and both are public by
# design. The PUBLISHABLE key comes from `npx supabase status -o json` (PUBLISHABLE_KEY). The service-role /
# secret key must NEVER be set here; it belongs to the backend only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
