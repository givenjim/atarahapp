# Atarah web — copy to .env.local (git-ignored). Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# App store buttons stay hidden ("launching soon") until the flag is true AND a URL is set.
NEXT_PUBLIC_STORE_LINKS_ENABLED=false
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
# Server-side API origin (no /api/v1).
ATARAH_API_BASE_URL=http://localhost:3000
# Supabase Auth (member sign-in on the web arrives later; only the config exists now). Both values are public
# by design. The PUBLISHABLE key comes from `npx supabase status -o json`. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
