# Atarah web — copy to .env.local (git-ignored). Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# App store buttons stay hidden ("launching soon") until the flag is true AND a URL is set.
NEXT_PUBLIC_STORE_LINKS_ENABLED=false
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
# Server-side API origin (no /api/v1).
ATARAH_API_BASE_URL=http://localhost:3000
